
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#101114">
<title>Чат Голдичечки</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{color-scheme:dark;--bg:#101114;--panel:#191a20;--panel2:#22232a;--gold:#e4bd68;--text:#f4f1e9;--muted:#9b9ba5;--line:#34343d}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.5 system-ui,Arial,sans-serif;min-height:100vh}
button,input,textarea{font:inherit}
button{cursor:pointer}
button:disabled{opacity:.5;cursor:wait}
.shell{max-width:980px;margin:auto;padding:24px 16px 50px}
header{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0 24px;border-bottom:1px solid var(--line);margin-bottom:24px}
.brand{display:flex;align-items:center;gap:12px}
.logo{display:grid;place-items:center;width:46px;height:46px;border:1px solid #8f7138;border-radius:13px;color:var(--gold);font-weight:900;font-size:23px}
.brand h1{font-size:20px;margin:0}
.brand p{margin:2px 0 0;color:var(--muted);font-size:12px}
.pill{border:1px solid #5b4a2d;color:var(--gold);border-radius:30px;padding:6px 11px;font-size:12px}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:18px}
.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:22px;min-width:0;margin-bottom:16px}
h2{font-size:18px;margin:0 0 8px}
.sub{color:var(--muted);margin:0 0 20px;font-size:13px}
.field{margin:14px 0}
label{display:block;color:#c7c5c0;font-size:13px;margin-bottom:7px}
input,textarea{width:100%;border:1px solid var(--line);border-radius:11px;background:#111216;color:var(--text);padding:13px;outline:none}
input:focus,textarea:focus{border-color:var(--gold)}
textarea{resize:vertical;min-height:52px;max-height:180px}
.btn{border:0;border-radius:11px;padding:12px 16px;background:var(--gold);color:#17130b;font-weight:750}
.btn.secondary{background:var(--panel2);border:1px solid var(--line);color:var(--text)}
.actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}
.actions .btn{flex:1}
.hidden{display:none!important}
#status{padding:12px 14px;border-radius:10px;background:#202127;color:#d5d2ca;white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;margin-top:18px}
#status.error{color:#ff9292;border:1px solid #65383b}
#status.success{color:var(--gold)}
.chathead{display:flex;justify-content:space-between;align-items:center;gap:12px}
#messages{margin:18px 0;display:flex;flex-direction:column;gap:10px;min-height:140px;max-height:48vh;overflow:auto;padding:4px}
.msg{padding:12px 14px;background:var(--panel2);border:1px solid #30313a;border-radius:12px;overflow-wrap:anywhere}
.msg b{color:var(--gold);font-size:13px}
.msg .body{margin-top:5px;white-space:pre-wrap}
.msg time{display:block;margin-top:7px;color:var(--muted);font-size:11px}
.composer{display:flex;gap:9px}
.composer textarea{flex:1;min-width:0}
.side{display:flex;flex-direction:column;gap:0}
.stat{padding:13px 0;border-bottom:1px solid var(--line)}
.stat strong{display:block;color:var(--gold);font-size:17px}
.stat span{color:var(--muted);font-size:12px}
.admin{border-color:#6e5935}
.admin h2{color:var(--gold)}
.foot{text-align:center;color:#696a74;font-size:12px;margin-top:24px}
@media(max-width:700px){.layout{grid-template-columns:1fr}.shell{padding:12px}.card{padding:17px}header{padding:10px 0 18px}.brand h1{font-size:17px}#messages{max-height:45vh}}
@media(max-width:390px){.pill{font-size:10px;padding:5px 7px}.composer{flex-direction:column}.composer button{width:100%}}
</style>
</head>
<body>
<div class="shell">
<header>
  <div class="brand">
    <div class="logo">G</div>
    <div><h1>Чат Голдичечки</h1><p>ПРИВАТНОЕ ПРОСТРАНСТВО</p></div>
  </div>
  <span class="pill">GOLD EDITION</span>
</header>

<div class="layout">
<main>
  <section class="card" id="auth">
    <h2>Добро пожаловать</h2>
    <p class="sub">Войди в аккаунт или создай новый.</p>
    <form id="authForm">
      <div class="field"><label for="email">Электронная почта</label><input id="email" type="email" autocomplete="email" placeholder="name@example.com" required></div>
      <div class="field"><label for="password">Пароль</label><input id="password" type="password" autocomplete="current-password" minlength="6" placeholder="Минимум 6 символов" required></div>
      <div class="actions">
        <button class="btn" id="login" type="submit">Войти</button>
        <button class="btn secondary" id="register" type="button">Регистрация</button>
      </div>
    </form>
  </section>

  <section class="card hidden" id="chat">
    <div class="chathead"><div><h2>Общий чат</h2><p class="sub" style="margin:4px 0 0">Сообщения участников</p></div><button class="btn secondary" id="logout" type="button">Выйти</button></div>
    <div id="messages" aria-live="polite">Загружаю сообщения…</div>
    <form id="sendForm" class="composer">
      <textarea id="message" maxlength="1000" rows="2" placeholder="Написать сообщение…" required></textarea>
      <button class="btn" id="send" type="submit">Отправить</button>
    </form>
    <button class="btn secondary" id="refresh" type="button" style="width:100%;margin-top:10px">Обновить сообщения</button>
  </section>

  <section class="card admin hidden" id="admin">
    <h2>Панель администратора</h2>
    <p>Роль администратора подтверждена базой данных.</p>
    <p class="sub">Удаление сообщений, мут и бан требуют отдельных защищённых серверных команд и здесь пока не включены.</p>
  </section>

  <div id="status" role="status" aria-live="polite">Подключение…</div>
</main>

<aside class="side">
  <section class="card">
    <h2>Информация</h2>
    <div class="stat"><strong>GOLD</strong><span>Тёмная тема с золотом</span></div>
    <div class="stat"><strong>Аккаунт</strong><span>Вход через Supabase</span></div>
    <div class="stat"><strong>Общий чат</strong><span>Обмен сообщениями</span></div>
  </section>
  <section class="card">
    <h2>Правила</h2>
    <p class="sub" style="margin-bottom:0">Уважай участников. Не отправляй пароли, секретные ключи и личные данные.</p>
  </section>
</aside>
</div>
<div class="foot">Чат Голдичечки · GOLD EDITION</div>
</div>

<script>
(() => {
'use strict';

const SUPABASE_URL='https://bkzvoktchnxidoeaklca.supabase.co';
const SUPABASE_KEY='sb_publishable_KiTpU3ATB2S7g4YCtac2fw_34-spY_p';
const $=id=>document.getElementById(id);
let db=null,currentUser=null,busy=false;

function status(message,type=''){
  $('status').textContent=message;
  $('status').className=type;
}
function explain(error){
  const m=error?.message||String(error||'Неизвестная ошибка');
  if(/invalid api key|api key/i.test(m))
    return 'Supabase отклонил API-ключ. Проверь Publishable key в настройках своего проекта: новый дизайн не может исправить неподходящий ключ.';
  if(/failed to fetch|networkerror|load failed/i.test(m))
    return 'Нет соединения с Supabase. Проверь интернет, VPN и доступность сервиса.';
  if(/invalid login credentials/i.test(m))
    return 'Неверная почта или пароль. Проверь данные или зарегистрируйся.';
  if(/email not confirmed/i.test(m))
    return 'Подтверди почту по ссылке из письма, затем войди.';
  return m;
}
function report(e){status(explain(e),'error')}
function setBusy(v){
  busy=v;
  ['login','register','send','logout','refresh'].forEach(id=>$(id).disabled=v);
}
function showUser(user){
  currentUser=user||null;
  $('auth').classList.toggle('hidden',!!currentUser);
  $('chat').classList.toggle('hidden',!currentUser);
  $('admin').classList.add('hidden');
}
async function register(){
  if(busy)return;
  const email=$('email').value.trim(),password=$('password').value;
  if(!email||password.length<6){status('Введи почту и пароль минимум из 6 символов.','error');return}
  setBusy(true);
  try{
    const {data,error}=await db.auth.signUp({email,password});
    if(error)throw error;
    if(data.session&&data.user){
      await updateUI(data.user);
      status('Регистрация успешна.','success');
    }else{
      status('Регистрация создана. Если требуется подтверждение почты, проверь письмо и затем войди.','success');
    }
  }catch(e){report(e)}finally{setBusy(false)}
}
async function login(e){
  if(e)e.preventDefault();
  if(busy)return;
  const email=$('email').value.trim(),password=$('password').value;
  if(!email||!password){status('Введи почту и пароль.','error');return}
  setBusy(true);
  try{
    const {data,error}=await db.auth.signInWithPassword({email,password});
    if(error)throw error;
    await updateUI(data.user);
    status('Вход выполнен.','success');
  }catch(e){report(e)}finally{setBusy(false)}
}
async function updateUI(user){
  showUser(user);
  if(!user)return;
  try{
    const {data,error}=await db.from('chat_roles').select('role').eq('user_id',user.id).maybeSingle();
    if(error)throw error;
    if(data?.role==='admin')$('admin').classList.remove('hidden');
  }catch(e){status('Вход выполнен, но роль администратора проверить не удалось: '+explain(e),'error')}
  await loadMessages();
}
async function loadMessages(){
  if(!currentUser||busy)return;
  $('messages').textContent='Загружаю сообщения…';
  try{
    const {data,error}=await db.from('messages').select('name,content,created_at').order('created_at',{ascending:true}).limit(100);
    if(error)throw error;
    $('messages').replaceChildren();
    if(!data?.length){$('messages').textContent='Пока сообщений нет. Напиши первым.';return}
    for(const msg of data){
      const item=document.createElement('article');item.className='msg';
      const name=document.createElement('b');name.textContent=msg.name||'Участник';
      const body=document.createElement('div');body.className='body';body.textContent=msg.content||'';
      item.append(name,body);
      if(msg.created_at){
        const time=document.createElement('time'),date=new Date(msg.created_at);
        time.textContent=Number.isNaN(date.getTime())?'':date.toLocaleString('ru-RU');
        item.append(time);
      }
      $('messages').append(item);
    }
    $('messages').scrollTop=$('messages').scrollHeight;
  }catch(e){$('messages').textContent='Не удалось загрузить сообщения.';report(e)}
}
async function sendMessage(e){
  e.preventDefault();
  if(busy||!currentUser)return;
  const content=$('message').value.trim();
  if(!content)return;
  setBusy(true);
  try{
    const name=(currentUser.email||'Участник').split('@')[0].slice(0,30);
    const {error}=await db.from('messages').insert({name,content:content.slice(0,1000)});
    if(error)throw error;
    $('message').value='';
    status('Сообщение отправлено.','success');
    await loadMessages();
  }catch(e){report(e)}finally{setBusy(false)}
}
async function logout(){
  if(busy)return;
  setBusy(true);
  try{
    const {error}=await db.auth.signOut();
    if(error)throw error;
    showUser(null);
    $('messages').replaceChildren();
    status('Ты вышел из аккаунта.','success');
  }catch(e){report(e)}finally{setBusy(false)}
}
async function init(){
  if(!window.supabase){
    status('Библиотека Supabase не загрузилась. Проверь соединение с интернетом.','error');
    return;
  }
  try{
    db=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
    const {data,error}=await db.auth.getSession();
    if(error)throw error;
    if(data.session?.user)await updateUI(data.session.user);
    else status('Готово. Войди или зарегистрируйся.','success');
    db.auth.onAuthStateChange((_event,session)=>{
      if(session?.user&&session.user.id!==currentUser?.id)updateUI(session.user);
    });
  }catch(e){report(e)}
}
$('authForm').addEventListener('submit',login);
$('register').addEventListener('click',register);
$('sendForm').addEventListener('submit',sendMessage);
$('logout').addEventListener('click',logout);
$('refresh').addEventListener('click',loadMessages);
init();
})();
</script>
</body>
</html>
